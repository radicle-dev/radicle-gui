#!/usr/bin/env bash
set -Eeuo pipefail

echo "Copying katex assets into bundle directory"

# katex is hoisted to the workspace root, so resolve it rather than assuming
# a local node_modules.
dist="$(dirname "$(node -p 'require.resolve("katex/package.json")')")/dist"

mkdir -p public/fonts
cp -r "$dist/katex.min.css" public/katex.min.css
cp -r "$dist"/fonts/* public/fonts/
